// Windows resources of forgecode.exe: its icon (Explorer, taskbar, shortcuts) and the details
// shown in its Properties. build.rs writes the version and the icon's full path in.
1 ICON "logo.ico"

1 VERSIONINFO
FILEVERSION VERSION_COMMAS
PRODUCTVERSION VERSION_COMMAS
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "ForgeCode"
      VALUE "FileDescription", "ForgeCode"
      VALUE "FileVersion", VERSION_TEXT
      VALUE "InternalName", "forgecode"
      VALUE "OriginalFilename", "forgecode.exe"
      VALUE "ProductName", "ForgeCode"
      VALUE "ProductVersion", VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
